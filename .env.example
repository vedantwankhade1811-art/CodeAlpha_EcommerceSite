# ==========================================
# Cartza Application Environment Variables
# Copy this file to .env and configure values
# ==========================================

SECRET_KEY=cartza-super-secret-dev-key-change-in-production-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ==========================================
# Razorpay Payment Gateway (Test Mode)
# ==========================================
# 1. Sign in or sign up at https://dashboard.razorpay.com/
# 2. Toggle to "Test Mode" in the top bar or left sidebar
# 3. Navigate to: Account & Settings -> API Keys (or visit https://dashboard.razorpay.com/app/keys)
# 4. Click "Generate Test Key" (or "Regenerate Test Key")
# 5. Copy the Key ID and Key Secret and paste them below:
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# Optional Webhook Secret: Settings -> Webhooks -> Add New Webhook
# Webhook URL: https://yourdomain.com/orders/payment/webhook/
# Secret: any secure string you configure on the webhook
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere
